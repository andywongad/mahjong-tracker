# Copy to .env.local for local work, and set the same names in Vercel.
# .env.local is gitignored and must never be committed.

# --- Supabase ---------------------------------------------------------------
# The publishable key is safe in the browser; row level security protects data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only. Bypasses row level security entirely, so it must never be given
# a NEXT_PUBLIC_ prefix and must never be read by a client component. It is the
# only thing that can read or write scan_events.
SUPABASE_SERVICE_ROLE_KEY=

# --- Scanning ---------------------------------------------------------------
ANTHROPIC_API_KEY=
# Set a monthly spend limit in the Anthropic console as well. While scanning is
# open to anyone, that limit is the backstop that actually holds.

SCAN_ENABLED=true
SCAN_MODEL=claude-haiku-5-5
SCAN_FALLBACK_MODEL=claude-sonnet-5-5
# low | medium | high | xhigh | max. Low is the cheapest and fastest, and the
# documented choice for simple high-volume extraction. Compare levels with
# `npm run scan:eval -- --effort medium` before changing it.
SCAN_EFFORT=low
# The long edge the browser shrinks a photo to before sending. 1568 was the old
# limit for every model; Haiku 5.5 reads up to 2576, at about 2.7x the visual
# tokens and still a fraction of a cent. Sweep it with scan:eval.
SCAN_MAX_LONG_EDGE=1568

# Off during the open test. Turning it on later is only this line.
SCAN_REQUIRE_SIGNIN=false

# --- Caps, all on a rolling 24 hours ----------------------------------------
# A full Hong Kong game is 16-24 hands, a long night can be two games, draws
# and false wins need no scan, and some photos get retaken: 2 x 22 x 1.3 ~ 57.
SCAN_DEVICE_DAILY_CAP=60
# Higher, because several tables can share one venue's wifi.
SCAN_IP_DAILY_CAP=150
# The real safety net. At roughly $0.0004 a scan this is well under a dollar.
SCAN_GLOBAL_DAILY_CAP=1000
# Replaces the device cap once sign-in is on.
SCAN_DAILY_CAP=60
SCAN_ADMIN_DAILY_CAP=200

# --- Abuse protection -------------------------------------------------------
# Cloudflare Turnstile. Verified server side; skipped in development and for an
# admin. A missing secret in production refuses every scan rather than waving
# them through.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Long random values. Generate with: openssl rand -hex 32
# The salt is what keeps raw IP addresses out of the database.
SCAN_IP_SALT=
# Pasted once into /admin/scan, then sent as a header. Never a URL flag.
SCAN_ADMIN_TOKEN=
