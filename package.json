{
  "name": "mahjong-tracker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/stamp-sw.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:sw": "node scripts/stamp-sw.mjs --check",
    "verify": "npm run typecheck && npm test && npm run check:contrast && npm run check:sw && npm run build",
    "shots:before": "SHOT_PHASE=before playwright test e2e/screenshots.spec.ts",
    "shots:after": "SHOT_PHASE=after playwright test e2e/screenshots.spec.ts",
    "shots:sheet": "node scripts/contact-sheet.mjs",
    "e2e": "playwright test",
    "scan:eval": "tsx scripts/scan-eval.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@supabase/supabase-js": "^2.117.2",
    "idb": "^8.0.3",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "happy-dom": "^20.14.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
